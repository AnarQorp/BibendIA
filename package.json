{
  "name": "bibendia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp dist/index.html dist/404.html && cp public/.nojekyll dist/.nojekyll",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.build.json",
    "start:api": "node server/dist/src/api/main.js",
    "start:worker": "node server/dist/src/worker/main.js",
    "start:migrator": "node server/dist/src/persistence/migrate.js",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:integration": "vitest run --config server/vitest.integration.config.ts",
    "test:bootstrap": "npm run build:server && sh server/test/bootstrap/clean-postgres-gate.sh",
    "test": "npm run typecheck:server && npm run test:server",
    "db:migrate": "tsx server/src/persistence/migrate.ts",
    "api": "tsx server/src/api/main.ts",
    "worker": "tsx server/src/worker/main.ts",
    "bakeoff:plan": "tsx server/src/bakeoff/cli.ts",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "secure-json-parse": "^4.0.0",
    "twilio": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@elevenlabs/client": "^1.25.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vapi-ai/web": "^2.7.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "gh-pages": "^6.3.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.1"
  }
}
